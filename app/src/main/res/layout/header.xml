<?xml version="1.0" encoding="utf-8"?>
<!-- Шапка экрана: название (и мелкая строка под ним) слева, кнопка меню справа, снизу голубая линия -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/header_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="48dip"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Аватарка чата (для экранов чата); без неё скрыта -->
        <ImageView
            android:id="@+id/headerAvatar"
            android:layout_width="36dip"
            android:layout_height="36dip"
            android:layout_marginLeft="8dip"
            android:contentDescription="@null"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/headerTitleBox"
            android:layout_width="0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="12dip"
            android:paddingRight="8dip">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Число участников/подписчиков и т.п.; без текста скрыта, и название стоит по центру -->
            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFB5C7E0"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/headerMenu"
            android:layout_width="48dip"
            android:layout_height="48dip"
            android:background="@drawable/header_btn"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_menu" />
    </LinearLayout>

    <View
        android:layout_width="fill_parent"
        android:layout_height="2dip"
        android:background="#FF33B5E5" />
</LinearLayout>
