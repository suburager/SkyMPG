<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Разделитель дней -->
    <TextView
        android:id="@+id/textDate"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingBottom="4dip"
        android:paddingTop="8dip"
        android:textColor="#FF999999"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Служебное сообщение -->
    <TextView
        android:id="@+id/textService"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:padding="6dip"
        android:textColor="#FF999999"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Строка с пузырём; сторона и поля задаются в коде -->
    <LinearLayout
        android:id="@+id/row"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="2dip"
        android:paddingTop="2dip">

        <org.mpgram.droid.BubbleLayout
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textFwd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF3A6EA5"
                android:textSize="12sp"
                android:textStyle="italic"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textQuote"
                android:tag="fill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dip"
                android:layout_marginTop="2dip"
                android:background="@drawable/quote_bg"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#FF444444"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Превью фото: одно или сетка из нескольких; заполняется в коде -->
            <LinearLayout
                android:id="@+id/mediaBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dip"
                android:layout_marginTop="2dip"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Кнопка "скачать все" у группы из нескольких файлов -->
            <TextView
                android:id="@+id/btnDownloadAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dip"
                android:layout_marginTop="2dip"
                android:background="@drawable/quote_bg"
                android:clickable="true"
                android:drawableLeft="@drawable/ic_download"
                android:drawablePadding="6dip"
                android:gravity="center_vertical"
                android:padding="6dip"
                android:text="@string/btn_download_all"
                android:textColor="#FF222222"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Текст и время: время в правом нижнем углу, для него в тексте оставлен просвет -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="fill">

                <org.mpgram.droid.FitTextView
                    android:id="@+id/textBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF000000"
                    android:textColorLink="#FF0645AD"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|right"
                    android:textColor="#FF777777"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- Реакции: капсулы создаются в коде и переносятся по строкам (видны все); в конце
                 стоит время, когда у сообщения есть реакции. Без реакций блок скрыт и места не занимает. -->
            <org.mpgram.droid.ReactFlow
                android:id="@+id/reactBox"
                android:tag="fill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dip"
                android:visibility="gone" />
        </org.mpgram.droid.BubbleLayout>
    </LinearLayout>
</LinearLayout>
