<?xml version="1.0" encoding="utf-8"?>
<!-- Панель выбора эмодзи под полем ввода: вкладки-категории сверху, сетка ниже. Высота задаётся в коде. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emojiPanel"
    android:layout_width="fill_parent"
    android:layout_height="200dip"
    android:background="#FF151D2E"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/emojiTabs"
        android:layout_width="fill_parent"
        android:layout_height="34dip"
        android:background="#FF1B2536"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <GridView
        android:id="@+id/emojiGrid"
        android:layout_width="fill_parent"
        android:layout_height="0dip"
        android:layout_weight="1"
        android:cacheColorHint="#00000000"
        android:columnWidth="44dip"
        android:fadingEdge="none"
        android:gravity="center"
        android:listSelector="@android:color/transparent"
        android:numColumns="auto_fit"
        android:stretchMode="columnWidth" />
</LinearLayout>
