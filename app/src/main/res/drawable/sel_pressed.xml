<?xml version="1.0" encoding="utf-8"?>
<!-- Выделение нажатого пункта в списках и меню: тот цвет, что получается у кнопки "Меню" в шапке
     при нажатии (голубой #33B5E5 с прозрачностью поверх шапки), сплошным цветом -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF29658C" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF29658C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
